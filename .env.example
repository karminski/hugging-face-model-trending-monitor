# Shared runtime config for server/ (HF Trending + AI Calendar).
# Copy to .env in the repository root.

# Any OpenAI-compatible /chat/completions endpoint (AI Calendar scenes).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.9
LLM_MAX_RETRIES=3
# Set to 0 if the endpoint rejects response_format: json_object.
LLM_JSON_MODE=1
LLM_TIMEOUT_MS=300000

# City for weather (Open-Meteo, no key) and the calendar card.
CITY_NAME=上海
CITY_LAT=31.23
CITY_LON=121.47
TZ=Asia/Shanghai

# Debug pages and device API. Use 0.0.0.0 so the ESP32 can reach it on the LAN.
HTTP_HOST=127.0.0.1
HTTP_PORT=8787

# Hugging Face Trending. hf-mirror.com does not support the expand= fields this API needs,
# so if huggingface.co is unreachable, set HF_PROXY to an HTTP proxy (used only for HF).
HF_BASE_URL=https://huggingface.co
HF_PROXY=
TRENDING_REFRESH_MIN=60

# AI Calendar schedule. Slots align to local midnight, so 60 = every full hour.
CALENDAR_INTERVAL_MIN=60
CALENDAR_RUN_ON_START=1
# Keep only the newest N scheduled outputs (0 = keep all).
CALENDAR_KEEP=0
CALENDAR_GALLERY_LIMIT=24

# Runtime data (trending snapshot, calendar outputs, weather cache), relative to server/.
DATA_DIR=data

# Optional: route outbound requests through a proxy.
# HTTPS_PROXY=http://127.0.0.1:10809
